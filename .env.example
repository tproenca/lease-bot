# Copy this file to supabase/.env.local and fill in the values.
# Never commit supabase/.env.local — it is gitignored.
#
#   cp .env.example supabase/.env.local
#
# First time? See docs/SETUP.md for step-by-step instructions on obtaining each value.
# In production, set these as Supabase Edge Function secrets:
#   supabase secrets set KEY=value --project-ref <project-ref>

# ── Supabase ──────────────────────────────────────────────────────────────────
# Local values are printed by `supabase start`.
# Production values: Supabase dashboard → Project Settings → API
SUPABASE_URL=http://localhost:54321   # Required
SUPABASE_ANON_KEY=                    # Required
SUPABASE_SERVICE_ROLE_KEY=            # Required

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Register all three redirect URIs in Google Cloud Console:
#   http://localhost:54321/functions/v1/auth/callback        (local browser flows)
#   https://<your-domain>.ngrok-free.dev/functions/v1/auth/callback  (GPT OAuth testing)
#   https://<project-ref>.supabase.co/functions/v1/auth/callback     (production)
# See docs/SETUP.md § Google Cloud Console for the full setup walkthrough.
GOOGLE_CLIENT_ID=      # Required
GOOGLE_CLIENT_SECRET=  # Required

# ── Google — optional ─────────────────────────────────────────────────────────
# PUBLIC_GOOGLE_API_KEY: enables the Google Drive Picker on the /setup onboarding page.
# Without it, landlords paste a folder ID manually — everything still works.
PUBLIC_GOOGLE_API_KEY=  # Optional

# PUBLIC_FUNCTIONS_BASE_URL: override the base URL for Edge Functions as seen from a browser.
# Defaults to ${SUPABASE_URL}/functions/v1. Only needed if functions are behind a custom domain.
PUBLIC_FUNCTIONS_BASE_URL=  # Optional

# GPT_URL: link to the Custom GPT shown on the post-setup success page.
GPT_URL=  # Optional

# ── Autentique (Phase 2 — E-Signature) ───────────────────────────────────────
# Per-landlord API keys are collected during onboarding and stored in the DB — not here.
# Only the webhook secret lives here: a single shared secret used to verify that
# incoming webhook payloads were signed by Autentique.
# See docs/SETUP.md § Autentique for how to generate and register it.
AUTENTIQUE_WEBHOOK_SECRET=  # Required for signing (Phase 2)

# ── Meta WhatsApp Business Cloud API (Phase 3 — Payment Reminders) ───────────
# https://developers.facebook.com/apps → your app → WhatsApp → API Setup
# The token is temporary (24 h) in sandbox mode — regenerate from the same screen.
# See docs/SETUP.md § Meta WhatsApp Business for full setup steps.
META_WHATSAPP_TOKEN=     # Required for reminders (Phase 3)
META_WHATSAPP_PHONE_ID=  # Required for reminders (Phase 3)
