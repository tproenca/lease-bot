# Copy this file to supabase/.env.local and fill in the values.
# Never commit supabase/.env.local — it is gitignored.
# In production, set these as Supabase Edge Function secrets:
#   supabase secrets set KEY=value --project-ref <project-ref>

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:54321/functions/v1/auth/callback (local)
#                          https://<project-ref>.supabase.co/functions/v1/auth/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Autentique (Phase 2 — E-Signature) ───────────────────────────────────────
# API keys are per-landlord — collected during onboarding and stored encrypted in the DB.
# Only the webhook secret is a global server-side secret.
# Webhook secret: set when registering the webhook endpoint in each landlord's Autentique account.
AUTENTIQUE_WEBHOOK_SECRET=

# ── Meta WhatsApp Business Cloud API (Phase 3 — Payment Reminders) ───────────
# Token and phone ID: https://developers.facebook.com/apps → WhatsApp → API Setup
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
